{
    "name": "atomicassets-api",
    "version": "1.3.24",
    "description": "AtomicAssets API: indexer and HTTP API for AtomicAssets, AtomicMarket, AtomicTools, and related contracts on Antelope (EOSIO) chains.",
    "license": "MIT",
    "author": "FACINGS INC.",
    "repository": {
        "type": "git",
        "url": "https://github.com/atomicassets/atomicassets-api.git"
    },
    "homepage": "https://github.com/atomicassets/atomicassets-api#readme",
    "bugs": {
        "url": "https://github.com/atomicassets/atomicassets-api/issues"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "check-types": "tsc --noEmit",
        "clean": "rm -rf ./build/* && rm -rf ./logs/*",
        "lint": "eslint \"src/**/*.ts\"",
        "build": "swc src -d build --strip-leading-paths",
        "test": "mocha --require @swc-node/register 'src/utils/**/*.test.ts' 'src/filler/jobqueue.test.ts' 'src/filler/utils.test.ts' 'src/filler/receiver.test.ts' 'src/api/utils.test.ts' 'src/api/namespaces/validation.test.ts' 'src/api/namespaces/atomictools/format.test.ts'",
        "test:integration": "[ -f config/connections.config.json ] && mocha --require @swc-node/register 'src/**/*.test.ts' || echo 'Integration tests skipped: config/connections.config.json not found'",
        "test:init-db": "node --require @swc-node/register src/bin/init-test-db.ts",
        "test:e2e:ci": "pnpm test:init-db && mocha --require @swc-node/register --timeout 30000 'src/**/*.test.ts'",
        "test:watch": "mocha --require @swc-node/register --watch --watch-extensions ts 'src/**/*.test.ts'",
        "test:coverage": "c8 mocha --require @swc-node/register --timeout 30000 'src/**/*.test.ts'",
        "test:coverage:ci": "pnpm test:init-db && c8 mocha --require @swc-node/register --timeout 30000 'src/**/*.test.ts'",
        "start": "node ./build/bin/server.js",
        "start:server": "node ./build/bin/server.js",
        "start:filler": "node ./build/bin/filler.js",
        "start:abiscan": "node ./build/bin/abiscan.js",
        "dev": "tsc --watch",
        "dev:server": "tsc && node --trace-warnings ./build/bin/server.js",
        "dev:filler": "tsc && node --trace-warnings ./build/bin/filler.js",
        "dev:abiscan": "tsc && node --trace-warnings ./build/bin/abiscan.js",
        "dev:test:watch": "mocha -r @swc-node/register 'src/**/*.test.ts' --watch --watch-files src/ --reporter min",
        "dev:init-test-db": "tsc && node --trace-warnings ./build/bin/init-test-db.js",
        "db:schema:init": "tsc && node --trace-warnings ./build/bin/init-schema.js",
        "db:migrate:up": "tsc && node --trace-warnings ./build/bin/migrate.js"
    },
    "dependencies": {
        "@wharfkit/antelope": "^1.1.1",
        "async-exit-hook": "^2.0.1",
        "atomicassets": "^1.4.2",
        "await-lock": "^2.2.1",
        "body-parser": "^1.20.3",
        "common-tags": "^1.8.2",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "int64-buffer": "^1.0.1",
        "iovalkey": "^0.3.3",
        "moize": "^6.1.1",
        "node-worker-threads-pool": "^1.5.1",
        "p-queue": "^6.6.2",
        "pg": "^8.18.0",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.3.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.7.2",
        "ws": "^8.17.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@swc-node/register": "^1.11.1",
        "@swc/cli": "^0.8.0",
        "@swc/core": "^1.13.0",
        "@types/body-parser": "^1.19.6",
        "@types/chai": "^5.2.3",
        "@types/chai-as-promised": "^8.0.2",
        "@types/common-tags": "^1.8.4",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.2",
        "@types/cors": "^2.8.19",
        "@types/elliptic": "^6.4.18",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^4.17.33",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.19.9",
        "@types/pg": "^8.16.0",
        "@types/sinon": "^21.0.0",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/ws": "^7.4.7",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "chai-as-promised": "^8.0.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "mocha": "^11.7.5",
        "sinon": "^21.0.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.45.0"
    },
    "private": true
}
