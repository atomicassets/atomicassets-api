{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitAny": false,
    "target": "es2020",
    "outDir": "./build",
    "sourceMap": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
