{
  "extends": "@atomichub/tsconfig/service.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitOverride": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "../../node_modules",
    "**/node_modules",
    "dist",
    "build",
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**/*"
  ]
}
